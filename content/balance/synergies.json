[
  {
    "name": "Debt Spiral",
    "perks": ["perk.technical_debt", "perk.ship_it"],
    "description": "Rushed deliveries pay another 25% on top.",
    "subscriptions": [{
      "event": "reward.calculated",
      "priority": 55,
      "conditions": [
        {"left": "job.completed", "operator": "==", "right": true},
        {"left": "job.time_remaining_ratio", "operator": "<", "right": 0.2}
      ],
      "effects": [{"operation": "multiply", "target": "job.reward", "value": 1.25}]
    }]
  },
  {
    "name": "Vibe Coding",
    "perks": ["perk.vibe_check", "perk.bug_alchemy"],
    "description": "Bugs are just vibes: every batch turns one more of them into progress.",
    "subscriptions": [{
      "event": "board.batch_finalizing",
      "priority": 28,
      "conditions": [{"left": "batch.known_bugs", "operator": ">", "right": 0}],
      "effects": [{"operation": "multiply", "target": "batch.progress_mult", "value": 1.15}]
    }]
  },
  {
    "name": "Recursive Nightmare",
    "perks": ["perk.rubber_duck", "perk.pipeline_momentum"],
    "description": "Each stage hands 10% more down the pipeline.",
    "subscriptions": [{
      "event": "board.stage_resolved",
      "priority": 72,
      "conditions": [],
      "effects": [{"operation": "multiply", "target": "stage.next_multiplier", "value": 1.1}]
    }]
  },
  {
    "name": "Bare Metal Doctrine",
    "perks": ["perk.works_on_my_machine", "perk.bare_metal"],
    "description": "Committed to owning the iron: another +25% on local throughput.",
    "subscriptions": [{
      "event": "compute.recalculate",
      "priority": 25,
      "conditions": [],
      "effects": [{"operation": "multiply", "target": "compute.local_rate", "value": 1.25}]
    }]
  }
]

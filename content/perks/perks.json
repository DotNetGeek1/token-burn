        {"operation": "add", "target": "batch.known_bugs", "value": -1}
      ]
    }]
  },
  {
    "id": "perk.free_trial",
    "name": "Free Trial",
    "rarity": "rare",
    "tags": ["cloud", "risk"],
    "description_template": "Cloud compute is free for the first {trial_prompts} prompts of a round and runs {trial_rate_pct}% faster; after that it bills {late_multiplier}× the going rate.",
    "parameters": {
      "trial_prompts": 3,
      "trial_rate_bonus": 1.15,
      "trial_rate_pct": 15,
      "late_multiplier": 4.0
    },
    "subscriptions": [
      {
        "event": "compute.recalculate",
        "priority": 15,
        "conditions": [{"left": "calendar.prompt", "operator": "<=", "right": "$trial_prompts"}],
        "effects": [
          {"operation": "discount", "target": "economy.cloud_cost_per_prompt", "value": 1.0},
          {"operation": "multiply", "target": "compute.cloud_rate", "value": "$trial_rate_bonus"}
        ]
      },
      {
        "event": "compute.recalculate",
        "priority": 16,
        "conditions": [{"left": "calendar.prompt", "operator": ">", "right": "$trial_prompts"}],
        "effects": [
          {"operation": "multiply", "target": "economy.cloud_cost_per_prompt", "value": "$late_multiplier"}
        ]
      }
    ]
  },

        "event": "board.batch_finished",
        "priority": 8,
        "conditions": [],
        "effects": [{
          "operation": "reroll",
          "target": "batch.quality",
          "value": {"min": "$quality_min", "max": "$quality_max"}
        }]
      }
    ]
  },

[
  {
    "id": "perk.ship_it",
    "name": "Ship It",
    "rarity": "rare",
    "tags": ["deadline", "reward", "risk"],
    "description_template": "Jobs completed with under {threshold}% time remaining pay {multiplier}×.",
    "parameters": {"threshold": 0.05, "multiplier": 2.0},
    "subscriptions": [{
      "event": "reward.calculated",
      "priority": 50,
      "conditions": [{"left": "job.time_remaining_ratio", "operator": "<", "right": "$threshold"}],
      "effects": [{"operation": "multiply", "target": "job.reward", "value": "$multiplier"}]
    }]
  },
  {
    "id": "perk.stack_overflow_tab",
    "name": "Stack Overflow Tab",
    "rarity": "common",
    "tags": ["quality", "bugs", "board"],
    "description_template": "Every batch quietly fixes its first bug and salvages {quality_restore} quality.",
    "parameters": {"quality_restore": 4},
    "subscriptions": [{
      "event": "board.batch_finished",
      "priority": 90,
      "conditions": [{"left": "batch.known_bugs", "operator": ">", "right": 0}],
      "effects": [
        {"operation": "add", "target": "batch.quality", "value": "$quality_restore"},
        {"operation": "add", "target": "batch.known_bugs", "value": -1}
      ]
    }]
  },
  {
    "id": "perk.free_trial",
    "name": "Free Trial",
    "rarity": "rare",
    "tags": ["cloud", "risk"],
    "description_template": "Cloud compute is free for the first {trial_prompts} prompts of a round, then costs {late_multiplier}× with deferred penalties of ${deferred_penalty}.",
    "parameters": {
      "trial_prompts": 3,
      "trial_rate_bonus": 1.15,
      "late_multiplier": 4.0,
      "deferred_penalty": 75
    },
    "subscriptions": [
      {
        "event": "prompt.started",
        "priority": 15,
        "conditions": [{"left": "calendar.prompt", "operator": "<=", "right": "$trial_prompts"}],
        "effects": [
          {"operation": "discount", "target": "economy.cloud_cost_per_prompt", "value": 1.0},
          {"operation": "multiply", "target": "compute.token_rate", "value": "$trial_rate_bonus"}
        ]
      },
      {
        "event": "prompt.started",
        "priority": 16,
        "conditions": [{"left": "calendar.prompt", "operator": ">", "right": "$trial_prompts"}],
        "effects": [
          {"operation": "multiply", "target": "economy.cloud_surcharge_liability", "value": "$late_multiplier"},
          {"operation": "defer_cost", "target": "economy.cash", "value": "$deferred_penalty", "prompts": 2}
        ]
      }
    ]
  },
  {
    "id": "perk.works_on_my_machine",
    "name": "Works on My Machine",
    "rarity": "common",
    "tags": ["local", "risk"],
    "description_template": "Local jobs gain +{bonus}% throughput.",
    "parameters": {"bonus": 25},
    "subscriptions": [{
      "event": "compute.recalculate",
      "priority": 10,
      "conditions": [],
      "effects": [{"operation": "multiply", "target": "compute.token_rate", "value": 1.25}]
    }]
  },
  {
    "id": "perk.technical_debt",
    "name": "Technical Debt",
    "rarity": "uncommon",
    "tags": ["cash", "risk"],
    "description_template": "Borrow ${cash} immediately; every batch ships one extra hidden bug and loses {bug_quality_penalty} quality.",
    "parameters": {"cash": 1500, "bug_quality_penalty": 4, "bug_quality_delta": -4},
    "subscriptions": [
      {
        "event": "perk.acquired",
        "priority": 5,
        "conditions": [],
        "effects": [{"operation": "borrow", "target": "economy.cash", "value": "$cash"}]
      },
      {
        "event": "board.batch_finished",
        "priority": 3,
        "conditions": [],
        "effects": [
          {"operation": "add", "target": "batch.hidden_bugs", "value": 1},
          {"operation": "add", "target": "batch.quality", "value": "$bug_quality_delta"}
        ]
      }
    ]
  },
  {
    "id": "perk.founder_mode",
    "name": "Founder Mode",
    "rarity": "uncommon",
    "tags": ["demand", "risk"],
    "description_template": "Advertising produces +{demand_bonus} demand; scope creep risk rises by {scope_creep_bonus} each quality tick.",
    "parameters": {"demand_bonus": 1, "scope_creep_bonus": 0.03},
    "subscriptions": [
      {
        "event": "round.started",
        "priority": 5,
        "conditions": [],
        "effects": [{"operation": "add", "target": "business.demand_modifier", "value": "$demand_bonus"}]
      },
      {
        "event": "board.batch_finished",
        "priority": 5,
        "conditions": [],
        "effects": [{"operation": "add", "target": "job.scope_creep_pct", "value": "$scope_creep_bonus"}]
      }
    ]
  },
  {
    "id": "perk.infinite_context",
    "name": "Infinite Context",
    "rarity": "legendary",
    "tags": ["tokens", "risk"],
    "description_template": "Token rate gains {growth_multiplier}× per round elapsed, stacking up to {max_stacks} times.",
    "parameters": {"growth_multiplier": 1.25, "max_stacks": 3},
    "subscriptions": [{
      "event": "prompt.started",
      "priority": 30,
      "conditions": [],
      "effects": [{
        "operation": "repeat",
        "value": "calendar.round",
        "max_repeats": "$max_stacks",
        "effects": [{"operation": "multiply", "target": "compute.token_rate", "value": "$growth_multiplier"}]
      }]
    }]
  },
  {
    "id": "perk.the_wrapper",
    "name": "The Wrapper",
    "rarity": "rare",
    "tags": ["passive", "reward"],
    "description_template": "Each completed job grants a {passive_ratio_pct}% clone bonus and spawns ${passive_income} of passive income every round.",
    "parameters": {"passive_ratio": 0.15, "passive_ratio_pct": 15, "passive_income": 25},
    "subscriptions": [{
      "event": "reward.calculated",
      "priority": 20,
      "conditions": [],
      "effects": [
        {
          "operation": "convert",
          "from": "job.reward",
          "target": "job.reward",
          "value": "$passive_ratio",
          "consume": false
        },
        {
          "operation": "spawn",
          "target": "build.status_effects",
          "value": {
            "id": "wrapper.passive",
            "source_perk": "perk.the_wrapper",
            "subscriptions": [{
              "event": "round.started",
              "priority": 5,
              "conditions": [],
              "effects": [{"operation": "add", "target": "economy.cash", "value": 25}]
            }]
          }
        }
      ]
    }]
  },
  {
    "id": "perk.vibe_check",
    "name": "Vibe Check",
    "rarity": "common",
    "tags": ["speed", "quality"],
    "description_template": "Ship on feel: +{speed_bonus}% throughput, but each batch's quality rerolls between {quality_min} and {quality_max}.",

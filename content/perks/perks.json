[
  {
    "id": "perk.ship_it",
    "name": "Ship It",
    "rarity": "rare",
    "tags": ["deadline", "reward", "risk"],
    "requires_tags": ["risk"],
    "description_template": "Jobs completed with under {threshold}% time remaining pay {multiplier}×.",
    "parameters": {"threshold": 0.05, "multiplier": 2.0},
    "subscriptions": [{
      "event": "reward.calculated",
      "priority": 50,
      "conditions": [{"left": "job.time_remaining_ratio", "operator": "<", "right": "$threshold"}],
      "effects": [{"operation": "multiply", "target": "job.reward", "value": "$multiplier"}]
    }]
  },
  {
    "id": "perk.stack_overflow_tab",
    "name": "Stack Overflow Tab",
    "rarity": "common",
    "tags": ["quality", "bugs", "board"],
    "description_template": "Every batch quietly fixes its first bug and salvages {quality_restore} quality.",
    "parameters": {"quality_restore": 4},
    "subscriptions": [{
      "event": "board.batch_finished",
      "priority": 90,
      "conditions": [{"left": "batch.known_bugs", "operator": ">", "right": 0}],
      "effects": [
